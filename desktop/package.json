{
  "name": "mn-laser-lab-manager-desktop",
  "version": "39.3.0",
  "description": "MN Laser Lab Manager Desktop - Electron + FastAPI + React",
  "author": "MN Laser Lab",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "pack:win": "electron-builder --win dir --x64"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.3.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.mnlaserlab.manager",
    "productName": "MN Laser Lab Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend/",
        "to": "backend/",
        "filter": ["**/*"]
      },
      {
        "from": "resources/frontend/",
        "to": "frontend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "MN-Laser-Lab-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MN Laser Lab Manager",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TUO_USERNAME_GITHUB",
        "repo": "mn-laser-lab-manager"
      }
    ]
  }
}
